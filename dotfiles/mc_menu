f -	Copy full path to clipboard
    "$SCRIPTS_DIR/absolute_path_to_clipboard.sh" %d/%f


d -	Copy current dir path to clipboard
	"$SCRIPTS_DIR/cd_to_clipboard.sh"

s	Save mc panel state to ~/.mc_state
	set --
	for i in %u; do
		set -- "$@" -u "$i"
	done
	for i in %U; do
		set -- "$@" -U "$i"
	done
	"$SCRIPTS_DIR/mc_save_state.py" -s %s -S %S -d %d -D %D "$@"

y	Copy selected filenames to clipboard
	text=$(
		first=1
		for i in %u; do
			if [ "$first" -eq 1 ]; then
				first=0
			else
				printf '\n'
			fi
			printf '%%s' "$i"
		done
	)
	"$SCRIPTS_DIR/clipit.sh" "$text"
